{
  "name": "oxill-mail",
  "version": "0.1.1",
  "description": "An experimental local-first desktop email client for Obsidian.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run check && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "imapflow": "^1.0.195",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.3.1"
  }
}
